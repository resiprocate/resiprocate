########################################################
# repro configuration file
########################################################
#
# Syntax:
#
#    SettingName = value
#
# Notes:
#  - Setting names are case insensitive.
#  - A line is a comment if its first non-whitespace character is '#'.
#    Trailing comments are NOT supported: everything after the '=' becomes
#    part of the value, including any '#' and the text following it.
#  - Every setting below documents the default that repro applies when the
#    setting is not present in this file.  Settings that are shipped
#    commented out are examples only - uncommenting one changes behaviour
#    away from the documented default.
#  - Boolean settings accept: true|false, on|off, enable|disable, 1|0
#  - Any setting may also be given on the command line as --SettingName=value
#    Command line settings override the values in this file.
#  - Relative filenames are resolved relative to the directory containing
#    this configuration file.


########################################################
# Log settings
########################################################

# Logging type
# Possible values: syslog|cerr|cout|file
# Note:  Logging to cout can negatively affect performance.  When repro is
#        placed into production, 'file' or 'syslog' should be used.
#        'syslog' is not available on Windows.
# Default: cout
#LoggingType = file

# Syslog facility to log to.
# Only applicable when LoggingType is set to syslog.
# Default: LOG_DAEMON
#SyslogFacility = LOG_LOCAL0

# Logging level
# Possible values: NONE|EMERG|ALERT|CRIT|ERR|WARNING|NOTICE|INFO|DEBUG|STACK
# Note:  An unrecognized value is treated as DEBUG.
#        The deprecated name LoggingLevel is still accepted as a fallback.
# Default: INFO
#LogLevel = DEBUG

# Log filename.
# Only applicable when LoggingType is set to file.
# A filename with no path component is resolved relative to the directory
# containing this configuration file.
# Note:  The deprecated name LoggingFilename is still accepted as a fallback.
# Default: the executable path repro was invoked with, plus ".log"
#          (ie. ./repro.log when started as ./repro)
#LogFilename = /var/log/repro/repro.log

# Log message structure
# Possible values: Unstructured|JSON_CEE
# Default: Unstructured
#LogMessageStructure = JSON_CEE

# Maximum size of the log file in bytes before it is rolled over.
# Only applicable when LoggingType is set to file.
# 0 means no limit.
# Default: 0
#LogFileMaxBytes = 5000000

# Maximum number of lines in the log file before it is rolled over.
# Only applicable when LoggingType is set to file.
# 0 means no limit.
# Default: 0
#LogFileMaxLines = 50000

# Set to true to configure logging to keep all log files.
# Only applicable when LoggingType is set to file.
# Default behaviour is to keep one .old file on roll over (ie: when
# LogFileMaxBytes or LogFileMaxLines is hit).
# WARNING:  Setting to true can fill your harddisk, so make sure you have an
#           external process to cleanup these files.
# Default: false
#KeepAllLogFiles = true

# Instance name to be shown in logs, very useful when multiple instances
# are logging to syslog concurrently.
# Default: (empty - no instance name is logged)
#LoggingInstanceName = repro-dev

# Enable INFO level SIP message logging - outputs all SIP messages sent
# and/or received to the log file in an easy to read format.
# This option has no effect if logging to HOMER is enabled by setting
# CaptureHost.
# Default: false
#EnableSipMessageLogging = true

# Hostname of the HOMER SIP capture server.
# If not specified, repro does not attempt to send any HEP packets.
# Default: (empty - HEP capture disabled)
#CaptureHost = localhost

# UDP port of the HOMER SIP capture server.
# Only applicable when CaptureHost is specified.
# Default: 9060
#CapturePort = 9061

# HOMER capture agent ID.
# Only applicable when CaptureHost is specified.
# Default: 2001
#CaptureAgentID = 2002


########################################################
# Transport settings
########################################################

# Set an upper limit on the maximum size of a SIP message payload that the
# stack will accept.  If a payload received over a connection-oriented
# transport exceeds this size, the connection will be dropped.
# This applies to TCP, TLS and WebSocket transports.  UDP payload sizes are
# limited by the maximum datagram size and any fragmentation constraints.
# 0 means use the stack built-in limit.
# Default: 0
#StreamMessageSizeLimit = 65536

# Local IP address to bind SIP transports to.
# If left blank, repro will bind to all adapters.
# Default: (empty - bind to all adapters)
#IPAddress = 192.168.1.106
#IPAddress = 2001:5c0:1000:a::6d

# Local port to listen on for SIP messages over UDP - 0 to disable
# Default: 5060
#UDPPort = 0

# Local port to listen on for SIP messages over TCP - 0 to disable
# Default: 5060
#TCPPort = 0

# Local port to listen on for SIP messages over TLS - 0 to disable
# Default: 5061
TLSPort = 0

# Local port to listen on for SIP messages over WS (WebSocket / WebRTC)
# 0 to disable
# Default: 80
WSPort = 0

# Local port to listen on for SIP messages over WSS (WebSocket / WebRTC TLS)
# 0 to disable
# Default: 443
WSSPort = 0

# Local port to listen on for SIP messages over DTLS - 0 to disable
# Default: 0
#DTLSPort = 5061

# TLS domain name for this server
# Note:  A domain cert for this domain must be present.
# Default: (empty)
#TLSDomainName = sipdomain.com

# PEM-encoded X.509 certificate for TLS.
# Must contain any intermediate certificates from the CA.
# The TLSCertificate and TLSPrivateKey settings are optional.  The stack will
# also try to automatically detect any suitable certificates in the directory
# specified by CertificatePath.
# Default: (empty)
#TLSCertificate = /etc/ssl/crt/sipdomain.com.pem

# PEM-encoded private key for TLS
# Default: (empty)
#TLSPrivateKey = /etc/ssl/private/sipdomain.com.key

# Private key pass phrase, if private keys are encrypted with a password
# Default: (empty)
#TLSPrivateKeyPassPhrase = password

# Whether or not we ask for (Optional) or expect (Mandatory) TLS clients to
# present a client certificate.
# Possible values:
#   None: client can connect without any cert, if a cert is sent, it is not
#         checked
#   Optional: client can connect without any cert, if a cert is sent, it must
#             be acceptable to us
#   Mandatory: client can not connect without any cert, cert must be
#              acceptable to us
# How we decide if a cert is acceptable: it must meet two criteria:
# 1. it must be signed by a CA that we trust (see CADirectory)
# 2. the domain or full sip: URI in the cert must match the From: URI of all
#    SIP messages coming from the peer
# Default: None
#TLSClientVerification = Optional

# The SSL or TLS connection mode to use.
# SSL v2 and v3 are deprecated and SSL v2 is particularly insecure and should
# be avoided.
# TLSv1 was the default up to and including reSIProcate v1.9.7.  With the
# setting TLSv1, only TLS v1.0 could be used and not TLS v1.1 or newer
# versions.
# The value SSLv23 works as a catch-all and gives the potential to allow all
# the SSL and TLS versions.  Despite the name SSLv23, it does not allow
# SSL v2.0 or v3.0 if the SSL_CTX_set_options method is used to prohibit them
# or if OpenSSL is compiled without them.
# See the page https://www.openssl.org/docs/ssl/SSL_CTX_new.html for a more
# detailed discussion of how repro will behave when using the values SSLv23
# or TLSv1 here.
# For optimal security and compatibility, use SSLv23 and make sure that either
# your OpenSSL is compiled without legacy SSL versions or that the setting
# OpenSSLCTXSetOptions (later in this file) contains the values
# SSL_OP_NO_SSLv2 and SSL_OP_NO_SSLv3.
#
#        TLSConnectionMethod          Supported
#              value                  protocol
#    ---------------------------------------------------
#
#            SSLv23                  TLS 1.0, 1.1, 1.2 and beyond
#                                      negotiated dynamically
#
#            TLSv1                   Only TLS 1.0 (problematic)
#
# Default: SSLv23
#TLSConnectionMethod = TLSv1

# Whether we accept the subjectAltName email address as if it was a SIP
# address (when checking the validity of a client certificate).
# Very few commercial CAs offer support for SIP addresses in subjectAltName.
# For many purposes, an email address subjectAltName may be considered
# equivalent within a specific domain.
# Currently, this accepts such certs globally (for any incoming connection),
# not just for connections from the local users.
# Default: false
#TLSUseEmailAsSIP = true

# TLS Diffie-Hellman (DH) parameters file.
#
# If specified, Diffie-Hellman can be used to enable Perfect Forward Secrecy
# (PFS) in those cases where the SIP proxy is acting as a TLS server and when
# the client tries to use a crypto suite involving Diffie-Hellman.
# The SIP proxy also supports ECDH regardless of whether a DH parameter file
# is available.
#
# The file can be generated with the command:
#
#     openssl dhparam -outform PEM -out dh2048.pem 2048
#
# Default: (empty - no DH parameters are loaded)
TlsDHParamsFilename = dh2048.pem

# Alternate and more flexible method to specify transports to bind to.
# If any Transport<Num>Interface setting is present, then the IPAddress and
# the individual port settings above are ignored.
# Transports MUST be numbered in sequential order, starting from 1.
# Possible settings are:
#
# Transport<Num>Interface = <IPAddress>:<Port>
#     Note:  For IPv6 addresses the last colon separates the IP address and
#            the port - square bracket notation is not used.
# Transport<Num>Type = <'TCP'|'UDP'|'TLS'|'DTLS'|'WS'|'WSS'>
#     Default: UDP
# Transport<Num>TlsDomain = <TLSDomain>
#     Only required if transport is TLS, DTLS or WSS.
# Transport<Num>TlsCertificate = <TLSCertificate>
#     Only for TLS, DTLS or WSS.
# Transport<Num>TlsPrivateKey = <TLSPrivateKey>
#     Only for TLS, DTLS or WSS.
# Transport<Num>TlsPrivateKeyPassPhrase = <TLSPrivateKeyPassPhrase>
#     Only for TLS, DTLS or WSS when the private key has a password.
# Transport<Num>TlsClientVerification = <'None'|'Optional'|'Mandatory'>
#     Default: None
# Transport<Num>TlsConnectionMethod = <'TLSv1'|'SSLv23'>
#     Default: SSLv23
# Transport<Num>RecordRouteUri = <'auto'|URI>
#     If set to auto then the record route URI is automatically generated from
#     the other transport settings.  Otherwise explicitly enter the full URI
#     you want repro to use.  Do not specify 'auto' if you specified the
#     IPAddress as INADDR_ANY (0.0.0.0).
#     Default: the global RecordRouteUri setting is used.
# Transport<Num>RcvBufLen = <SocketReceiveBufferSize>
#     Currently only applies to UDP transports.
#     Default: 0 - use the OS default.
#
# Example:
#Transport1Interface = 192.168.1.106:5060
#Transport1Type = TCP
#Transport1RecordRouteUri = auto
#
#Transport2Interface = 192.168.1.106:5060
#Transport2Type = UDP
#Transport2RecordRouteUri = auto
#Transport2RcvBufLen = 10000
#
#Transport3Interface = 192.168.1.106:5061
#Transport3Type = TLS
#Transport3TlsDomain = sipdomain.com
#Transport3TlsCertificate = /etc/ssl/crt/sipdomain.com.crt
#Transport3TlsPrivateKey = /etc/ssl/private/sipdomain.com.key
#Transport3TlsPrivateKeyPassPhrase = password
#Transport3TlsClientVerification = Mandatory
#Transport3RecordRouteUri = sip:h1.sipdomain.com;transport=TLS
#
#Transport4Interface = 2666:f0d0:1008:88::4:5060
#Transport4Type = UDP
#Transport4RecordRouteUri = auto
#
#Transport5Interface = 192.168.1.106:5062
#Transport5Type = WS
#Transport5RecordRouteUri = auto
#
#Transport6Interface = 192.168.1.106:5063
#Transport6Type = WSS
#Transport6TlsDomain = sipdomain.com
#Transport6TlsClientVerification = None
#Transport6RecordRouteUri = sip:h1.sipdomain.com;transport=WS

# Comma separated list of DNS servers, overrides the default OS detected list.
# Default: (empty - use the OS detected list)
#DNSServers = 8.8.8.8, 8.8.4.4

# Enable IPv6
# Default: true
#EnableIPv6 = false

# Disable IPv4
# Default: false
#DisableIPv4 = true

# Non-outbound connections over this age (expressed in seconds) are considered
# eligible for garbage collection.
# If not set but FlowTimer is set, then this value defaults to 7200 seconds.
# Otherwise, there is no garbage collection at all unless an error occurs when
# making an outgoing connection.
# Default: 0 (disabled)
#TCPConnectionGCAge = 7200

# File descriptor headroom threshold for emergency garbage collection.
# If the difference between the number of permitted FDs (reported by periodic
# calls to getrlimit()) and the number of active stream connections falls
# below this threshold, the garbage collector will overlook TCPConnectionGCAge
# and FlowTimer settings and more aggressively close connections.
# Remember that the value must be high enough to allow file descriptors for
# each shared library that is open, each database connection, each listening
# socket and any sockets/files accessed by plugins.
# Default: 0 (disabled)
#TCPMinimumGCHeadroom = 100


########################################################
# HTTP administration interface settings
########################################################

# Comma separated list of IP addresses used for binding the HTTP
# configuration interface and/or certificate server.
# If left blank it will bind to all adapters.
# Default: (empty - bind to all adapters)
HttpBindAddress = 127.0.0.1, ::1

# Port on which to run the HTTP configuration interface and/or certificate
# server - 0 to disable
# Default: 5080
#HttpPort = 0

# Disable HTTP digest challenges for the web based configuration GUI
# Default: false
#DisableHttpAuth = true

# Realm to use for HTTP admin interface digest authentication.
# Default: the first domain configured via Domains, DomainSuffixes or the
#          database, or "Unconfigured" if no domain is configured.
HttpAdminRealm = repro

# File containing user/password details.
#
# The format is:
#
#   username:realm:HA1
#
# where
#
#   user = admin
#   realm = the value from HttpAdminRealm
#   HA1 = `echo -n user:realm:password | md5sum`
#
# You can use the htdigest utility from Apache to create and manage this file.
#
# Default: users.txt
#HttpAdminUserFile = /etc/repro/users.txt


########################################################
# Command server settings
########################################################

# Comma separated list of IP addresses used for binding the Command Server
# listeners.  If left blank it will bind to all adapters.
# Default: (empty - bind to all adapters)
CommandBindAddress = 127.0.0.1, ::1

# Port on which to listen for and send XML RPC messaging used in command
# processing - 0 to disable
# Default: 5081
#CommandPort = 0

# Listen for commands on an AMQP queue.
# Responses can be sent to a dynamic queue (reply-to) using some AMQP brokers
# like qpidd.
# Requires repro to be built with Qpid Proton support.
# Default: (empty - disabled)
#CommandQueue = localhost:5672/queue/sip.repro.cmd

# Broadcast events (for example, statistics) to an AMQP topic.
# Requires repro to be built with Qpid Proton support.
# Default: (empty - disabled)
#CommandEventTopic = localhost:5672/topic/sip.repro.event


########################################################
# Registration / publication replication settings
########################################################

# Port on which to listen for and send XML RPC messaging used in the
# registration/publication sync process - 0 to disable
# Default: 0
#RegSyncPort = 5082

# Port on which to connect to the RegSync peer for the registration/
# publication sync process.
# Default: 0 - use the same value as RegSyncPort
#RemoteRegSyncPort = 5082

# Hostname/IP address of another instance of repro to synchronize
# registrations with.
# Note:  RegSyncPort or RemoteRegSyncPort must also be specified.
# Default: (empty - disabled)
#RegSyncPeer = repro-peer.example.org

# AMQP broker / topic to send reg sync messages to.
# Requires repro to be built with Qpid Proton support.
# Default: (empty - disabled)
#RegSyncBrokerTopic = localhost:5672/topic/sip.registration.announce

# Enable publication synchronization.
# Currently only applies to presence publications.
# Requires RegSyncPort to be specified.
# Default: false
EnablePublicationReplication = true


########################################################
# Database settings
########################################################

# Databases can be file based, SQL based or something else.
# Multiple databases can be defined, the definitions are indexed, just like
# the advanced transport configuration.
# The only mandatory setting is the Database<Num>Type setting.
# Supported types:
#
#     BerkeleyDB        the traditional *.db files
#     MySQL             a MySQL database
#     PostgreSQL        a PostgreSQL database
#
# Other parts of the configuration can refer to the databases by their index
# number (see RuntimeDatabase and RequestFilterDatabase).

# Directory used for BerkeleyDB files when no explicit path is given, and for
# the accounting event queues (sessioneventqueue and regeventqueue).
# Default: ./
#DatabasePath = /var/lib/repro/

# Declare which Database definition is the default.
# Default: -1 - no indexed database; fall back to a BerkeleyDB stored in
#          DatabasePath (or to the deprecated MySQLServer settings).
DefaultDatabase = 1

# Defines a BerkeleyDB storing the files in Database1Path:
Database1Type = BerkeleyDB

# Directory for the BerkeleyDB files of this database definition.
# Default: the value of DatabasePath (which itself defaults to ./)
#Database1Path = /var/lib/repro/

# Alternatively, define an SQL database.
#
# WARNING: repro must be compiled with the USE_MYSQL or USE_POSTGRESQL flags
# for this to work.
#
#Database1Type = MySQL
#Database1Type = PostgreSQL

# A PostgreSQL conninfo string, leave blank if you prefer to specify the
# hostname, port and other details individually.  repro will combine the
# conninfo string you specify here (if any) with individual details you
# specify using the Host, Port, DatabaseName, Username and Password settings
# to create the complete conninfo string used for the connection.
# You may want to leave all the other settings blank and just specify a
# conninfo string.  You can also choose to leave the password out of the
# conninfo string and include it from another file with restricted read
# permissions.  If you specify a password as part of the conninfo string it
# may appear in logs, if you specify it using the Password setting then it
# should be suppressed in logs.
# Default: (empty)
#Database1ConnInfo = host=localhost port=5432 dbname=repro user=repro

# The hostname running the SQL server to connect to.
# The value of host may be either a host name or an IP address.  If host is
# "localhost", a connection to the local host is assumed.  For Windows, the
# client connects using a shared-memory connection, if the server has
# shared-memory connections enabled.  Otherwise, TCP/IP is used.  For Unix,
# the client connects using a Unix socket file.  For a host value of "." on
# Windows, the client connects using a named pipe, if the server has
# named-pipe connections enabled.  If named-pipe connections are not enabled,
# an error occurs.
# Note:  For a MySQL database this setting is mandatory; for a PostgreSQL
#        database either this setting or Database1ConnInfo is mandatory.
# Default: (empty)
#Database1Host = localhost

# The SQL login ID to use when connecting to the SQL server.  If user is the
# empty string "", the current user is assumed.  Under Unix, this is the
# current login name.  Under Windows, the current user name must be specified
# explicitly.
# Default: (empty)
#Database1User = repro

# The password for the SQL login ID specified.
# Default: (empty)
#Database1Password = repro

# The database name on the SQL server that contains the repro tables.
# Default: (empty)
#Database1DatabaseName = repro

# If port is not 0, the value is used as the port number for the TCP/IP
# connection.  Note that the host setting determines the type of connection.
# Default: 0 - use the client library default (3306 for MySQL,
#          5432 for PostgreSQL)
#Database1Port = 3306

# If you would like to be able to authenticate users from a SQL source other
# than the repro user database table itself, or if you want to customize the
# query to use the passwordHashAlt (HA1B hash) or consider the values of other
# columns, then specify the query here.  The following conditions apply:
# 1.  The database table must reside on the same SQL server instance as the
#     repro database or RuntimeDatabase.
# 2.  The statement provided will be UNION'd with the hardcoded repro query,
#     so that auth from both sources is possible.  Note:  If the same user
#     exists in both tables, then the repro auth info will be used.
# 3.  The provided SELECT statement must return the SIP A1 password hash of
#     the user in question.
# 4.  The provided SELECT statement must contain two tags embedded into the
#     query: $user and $domain.  These tags should be used in the WHERE
#     clause, and repro will replace these tags with the actual user and
#     domain being queried.
#
# Example:
#    SELECT sip_password_ha1 FROM directory.users WHERE sip_userid = '$user' AND sip_domain = '$domain' AND account_status = 'active'
#
# Example for passwordHashAlt (PostgreSQL):
#    SELECT passwordHashAlt FROM users WHERE username = '$user' AND domain = 'example.org'
#
# Example for passwordHashAlt (MySQL):
#    SELECT passwordHashAlt FROM users WHERE user = '$user' AND domain = 'example.org'
#
# Example for hashing a cleartext password on the fly (MySQL):
#    SELECT MD5(CONCAT(user, ':', domain, ':', secret)) FROM insecure_users WHERE user = '$user' AND domain = 'example.org'
#
# Default: (empty - use the hardcoded repro query only)
#Database1CustomUserAuthQuery =

# If you want to use an alternative query to validate TLS peer names, specify
# it here.  The default query is:
#
#    SELECT count(1) FROM tlsPeerIdentity WHERE peerName IN ($peerNames) AND authorizedIdentity IN ($identities)
#
# where $peerNames is the CN or subjectAltName from the peer's certificate and
#       $identities are a comma-separated list of values (From URI, domain
#       from From URI)
#
# The query must return a 0 for no match and a positive number if authorized.
#
# Example, making a comparison where the macAddress column contains
# colon-delimited MAC addresses and the certificates contain MAC addresses
# without colons.  This is not very efficient, it would be better to cache the
# MAC addresses without colons in another column but it demonstrates how
# significant flexibility can be achieved by customizing the query:
#    SELECT count(1) FROM tlsPeerIdentity WHERE REPLACE(macAddress, ':', '') IN ('$peerNames') AND authorizedIdentity IN ($identities)
#
# Default: (empty - use the hardcoded repro query shown above)
#Database1CustomTlsAuthQuery =

# If you want to add a prefix to table names, specify it here.
#
# For example, if you have created tables using non-standard names such as
# test_users, test_routesavp, test_siloavp then you would set the setting:
#
#    Database1TableNamePrefix = test_
#
# and repro will use the alternate table names.
#
# If you specify Database1CustomUserAuthQuery or Database1CustomTlsAuthQuery
# they are not affected by this setting.
#
# This is particularly useful if multiple repro instances are sharing access
# to a single SQL database where some tables (or views) are shared by all
# repro instances while other tables (or views) are specific to each instance.
#
# Default: (empty - no prefix)
#Database1TableNamePrefix = test_

# The Users, tlsPeerIdentity and MessageSilo database tables are different
# from the other repro configuration database tables, in that they are
# accessed at runtime as SIP requests arrive.  It may be desirable to use
# BerkeleyDB for the other repro tables (which are read at startup time, then
# cached in memory), and SQL for the runtime tables; or two separate SQL
# instances for these different table sets.  Use the following settings in
# order to specify a separate database instance for use by the Users,
# tlsPeerIdentity and MessageSilo tables.
#
# Here we define database '2':
#Database2Type = PostgreSQL
#Database2Host = localhost
#Database2User = repro
#Database2Password = repro
#Database2DatabaseName = repro
#Database2Port = 5432
#Database2CustomUserAuthQuery =
#Database2CustomTlsAuthQuery =
#Database2TableNamePrefix =

# Use RuntimeDatabase to choose the database index used for the runtime
# tables.
# Default: -1 - use the DefaultDatabase
#RuntimeDatabase = 2


########################################################
# Accounting settings
########################################################

# Session Accounting - When enabled, resiprocate will push JSON formatted
# events for SIP session related messaging that the proxy receives, to a
# persistent message queue that uses BerkeleyDB backed storage.
# The following session events are logged:
#   Session Created - INVITE passing authentication was received
#   Session Routed - received INVITE was forwarded to a target
#   Session Redirected - session was 3xx redirected or REFERed
#   Session Established - there was a 2xx answer to an INVITE (only generated
#                         for the first 2xx)
#   Session Cancelled - CANCEL was received
#   Session Ended - BYE was received from either end
#   Session Error - a 4xx, 5xx, or 6xx response was sent to the inviter
# Consuming Accounting Events:
# Users must ensure that this message queue is consumed, or it will grow
# without bound.  A queuetostream consumer process is provided, that will
# consume the events from the message queue and stream them to stdout.  This
# output stream can be consumed by linux scripting tools and converted to
# database records or some other relevant representation of the data.
# For example: ./queuetostream ./sessioneventqueue > streamconsumer
# In the future an SQL consumer may also be provided in order to update
# session accounting records in a SQL database table.
# Note:  The queue is stored under DatabasePath.
# Default: false
#SessionAccountingEnabled = true

# Determines if repro will add routing header information (ie. Route and
# Record-Route headers) to the Session Created, Session Routed and Session
# Established events.
# Default: false
#SessionAccountingAddRoutingHeaders = true

# Determines if repro will add Via header information to the Session Created
# event.
# Default: false
#SessionAccountingAddViaHeaders = true

# Registration Accounting - When enabled, resiprocate will push JSON formatted
# events for every registration, re-registration, and unregistration message
# received to a persistent message queue that uses BerkeleyDB backed storage.
# The following registration events are logged:
#   Registration Added - initial registration received
#   Registration Refreshed - registration refresh received / re-register
#   Registration Removed - registration removed by client / unregister
#   Registration Removed All - all contacts registration removed / unregister
# Consuming Accounting Events:
# Users must ensure that this message queue is consumed, or it will grow
# without bound.  A queuetostream consumer process is provided, that will
# consume the events from the message queue and stream them to stdout.  This
# output stream can be consumed by linux scripting tools and converted to
# database records or some other relevant representation of the data.
# For example: ./queuetostream ./regeventqueue > streamconsumer
# In the future an SQL consumer may also be provided in order to update
# login/registration accounting records in a SQL database table.
# Note:  The queue is stored under DatabasePath.
# Default: false
#RegistrationAccountingEnabled = true

# Determines if repro will add routing header information (ie. Route and Path
# headers) to registration accounting events.
# Default: false
#RegistrationAccountingAddRoutingHeaders = true

# Determines if repro will add Via header information to the registration
# accounting events.
# Default: false
#RegistrationAccountingAddViaHeaders = true

# Determines if repro will log the Registration Refreshed events.
# Default: false
#RegistrationAccountingLogRefreshes = true


########################################################
# Misc settings
########################################################

# Directory where plugins are located.
# Default: determined at build time depending upon the target environment and
#          the installation prefix passed to the configure script.
#PluginDirectory = /usr/lib/repro/plugins

# List of plugins to load (comma separated list).
# These are the names of the plugins and not the full filenames.
# Order is important: the plugins will always be loaded and initialized in the
# order specified here.
# Plugins are not supported on all platforms and plugin support is an optional
# feature that must be enabled at compile time.
#
# For example, to load the plugin named "example", which is in libexample.so:
# Default: (empty - no plugins are loaded)
#LoadPlugins = example

# Drop privileges and run as some other user and group.
# If RunAsUser is specified and RunAsGroup is not specified, then setgid will
# be invoked using the default group for the specified user.
# If neither setting is specified, then no attempt will be made to call
# setuid/setgid.
# Default: (empty - privileges are not dropped)
#RunAsUser = repro
#RunAsGroup = repro

# Fork into the background and run as a daemon.
# Not supported on Windows.
# Default: false
#Daemonize = true

# On UNIX it is normal to create a PID file.
# Default: (empty - no attempt will be made to create a PID file)
#PidFile = /var/run/repro/repro.pid

# Note that repro loads ALL root certificates found by any of the settings
#
#    CADirectory
#    CAFile
#    CertificatePath
#
# Setting one option does not disable the other options.

# Path(s) to load root certificates from.
# If this directory is specified, all files in the directory will be loaded as
# root certificates, prefixes and suffixes are not considered.
#
# Multiple directories may be specified, separated by commas.
#
# On Debian, the typical location is /etc/ssl/certs.
# On Red Hat/CentOS, there isn't a directory like this.
# Default: (empty)
#CADirectory = /etc/ssl/certs
#CADirectory = /etc/ssl/certs, /usr/local/etc/ssl/phone-certs

# Specify file(s) containing one or more root certificates and possible
# chain/intermediate certificates to be loaded.
# If filenames are specified, the certificates in the files will be loaded as
# root certificates.
#
# Multiple filenames may be specified, separated by commas.
#
# This option is typically used to load a bundle of certificates such as
# /etc/ssl/certs/ca-certificates.crt on Debian and /etc/pki/tls/cert.pem on
# Red Hat/CentOS.
#
# Default: (empty)
#
# Uncomment for Debian/Ubuntu:
#CAFile = /etc/ssl/certs/ca-certificates.crt
# Uncomment for Fedora, Red Hat, CentOS:
#CAFile = /etc/pki/tls/cert.pem

# Path to load certificates from.
# Certificates in this location have to match one of the filename patterns
# expected by the legacy reSIProcate SSL code:
#
#   domain_cert_NAME.pem, root_cert_NAME.pem, ...
#
# For domain certificates, it is recommended to use the settings for
# individual transports, such as Transport<Num>TlsCertificate and
# Transport<Num>TlsPrivateKey, and not set CertificatePath at all.
#
# Default: (empty)
#CertificatePath = /etc/repro/certs

# Allow peers to present wildcard certificates, e.g. *.domain.com for
# proxy.domain.com
# Default: false
#AllowWildcardCertificates = true

# This option specifies the complete set of flags to be passed to OpenSSL's
# SSL_CTX_set_options method after creating the SSL context for a transport.
#
# WARNING: If this setting is specified, it REPLACES the default flags listed
# below rather than adding to them.  Include every flag you require.
#
# Default: SSL_OP_NO_SSLv2, SSL_OP_NO_SSLv3, SSL_OP_NO_COMPRESSION
#OpenSSLCTXSetOptions = SSL_OP_NO_SSLv2, SSL_OP_NO_SSLv3

# This option specifies the complete set of flags to be passed to OpenSSL's
# SSL_CTX_clear_options method after creating the SSL context for a transport.
#
# The flags here are removed from any existing flags already set within the
# OpenSSL stack.
#
# To clear the option SSL_OP_NO_SSLv3 and get SSLv3 support (not recommended
# for security reasons), uncomment the example below.
#
# Default: (empty - no flags are cleared)
#OpenSSLCTXClearOptions = SSL_OP_NO_SSLv3

# This setting specifies the cipher list to be passed to
# SSL_CTX_set_cipher_list.
# See https://www.openssl.org/docs/apps/ciphers.html for details of the format
# of this setting.
#
# Default: HIGH:-COMPLEMENTOFDEFAULT (defined in the code as
#          BaseSecurity::StrongestSuite)
#
# A weaker cipher list suitable for US export and compatibility with older
# devices:
#OpenSSLCipherList = HIGH:RC4-SHA:-COMPLEMENTOFDEFAULT

# Run a Certificate Server - allows PUBLISH and SUBSCRIBE for certificates
# Default: false
#EnableCertServer = true

# Value of the Server and User-Agent headers for local UAS and registration
# server responses.
# Default: "repro <PACKAGE_VERSION>" if PACKAGE_VERSION is defined during
#          compilation; no header is generated at all otherwise.
#ServerText = My SIP Proxy

# Enable congestion management
# Default: true
#CongestionManagement = false

# Congestion management metric - can take one of the following values:
# SIZE : Based solely on the number of messages in each fifo.
# TIME_DEPTH : Based on the age of the oldest (front-most) message in each
#              fifo.
# WAIT_TIME : Based on the expected wait time for each fifo; this is
#             calculated by multiplying the size by the average service time.
#             This is the recommended metric.
# Only applicable when CongestionManagement is true.
# Default: WAIT_TIME
#CongestionManagementMetric = SIZE

# Congestion management tolerance for the given metric.  This determines when
# the RejectionBehavior changes.
# 0-80 percent of max tolerance -> NORMAL (Not rejecting any work.)
# 80-100 percent of max tolerance -> REJECTING_NEW_WORK (Refuses new work, not
#        continuation of old work.)
# >100 percent of max tolerance -> REJECTING_NON_ESSENTIAL (Rejecting all work
#      that is non-essential to the health of the system (ie, if dropping
#      something is liable to cause a leak, instability, or state-bloat, don't
#      drop it.  Otherwise, reject it.)
# Units specified are dependent on the metric specified above:
#  If the metric is SIZE then units are the number of messages.
#  If the metric is TIME_DEPTH then units are the number of seconds old the
#     oldest message is.
#  If the metric is WAIT_TIME then units are the expected wait time of each
#     fifo in milliseconds.
# Only applicable when CongestionManagement is true.
# Default: 200
#CongestionManagementTolerance = 500

# Number of seconds between writes of the stack statistics block to the log
# files.  Specifying 0 will disable statistics collection entirely.  If
# disabled, the statistics also cannot be retrieved using the reprocmd
# interface.
# Default: 60
StatisticsLogInterval = 3600

# Use multiple threads for stack processing.
# Default: true
#ThreadedStack = false

# The number of worker threads used to asynchronously retrieve user
# authentication information from the database store.
# Values less than 1 are treated as 1.
# Default: 2
#NumAuthGrabberWorkerThreads = 4

# The number of worker threads in the Async Processor thread pool.  Used by
# all Async Processors (ie. RequestFilter).
# Default: 2
#NumAsyncProcessorWorkerThreads = 4

# Specify domains for which this proxy is authoritative (in addition to those
# specified on the web interface) - comma separated list.
# Notes: * Domains specified here cannot be used when creating users; domains
#          used in user AORs must be specified on the web interface.
#        * In previous versions of repro, localhost, 127.0.0.1, the machine's
#          hostname, and all interface addresses would automatically be
#          appended to this configuration setting.  From now on, such values
#          must be listed here explicitly if required, although when using TLS
#          only, it is not desirable or necessary to add such values.
# Default: (empty)
#Domains = localhost, 127.0.0.1, sip-server.example.org, 10.83.73.80

# Specify domain suffixes for which this proxy is authoritative.
# The proxy will be authoritative for any domain specified in this list and
# any subdomain of the entries in this list.  Comma separated list.
# Notes: * Domains specified here cannot be used when creating users; domains
#          used in user AORs must be specified on the web interface.
# Default: (empty)
#DomainSuffixes = example.org, example.com

# Add rport to the Via header we insert in requests.
# This is enabled by default but in some situations, such as working around
# bug #137, it may be desirable to disable it.
# Default: true
#AddViaRport = false

# URI to use as Record-Route
# Default: (empty)
#RecordRouteUri = sip:h1.sipdomain.com;transport=TLS

# Force record-routing.
# WARNING: Before enabling this, ensure you have a RecordRouteUri setup, or
# are using the alternate transport specification mechanism and defining a
# RecordRouteUri per transport: Transport<Num>RecordRouteUri
# Default: false
#ForceRecordRouting = true

# Disable the registrar
# Default: false
#DisableRegistrar = true

# Enable the Presence server
# Default: false
EnablePresenceServer = true

# Will report "open" basic presence for AORs that are registered, but don't
# publish presence.  Always reports "closed" basic presence for unregistered
# AORs.
# Default: true
PresenceUsesRegistrationState = false

# If enabled, the presence server will fabricate a simple presence closed
# state for users that haven't published any presence.  If disabled then a 480
# response is returned.
# Note:  This setting has no effect when PresenceUsesRegistrationState is set
#        to true.
# Default: true
#PresenceNotifyClosedStateForNonPublishedUsers = false

# Specify a comma separated list of enum suffixes to search for enum DNS
# resolution.
# Default: (empty - ENUM suffix lookups are not used)
#EnumSuffixes = e164.arpa

# Specify the target domain(s) for ENUM logic support.  When a dialed SIP URI
# is addressed to +number@somedomain, where somedomain is an element of
# EnumDomains, the ENUM logic will be applied for the number.
# Note:  EnumSuffixes must also be specified for this setting to take effect.
# Default: (empty - ENUM is never used)
#EnumDomains = example.org

# Specify the length of timer C in seconds.
# 0 or negative will disable timer C.
# Default: 180
#TimerC = 0

# Override the default value of T1 in ms (you probably should not change
# this).
# Default: 0 - use the stack default of 500ms
#TimerT1 = 500

# The amount of time, in ms, to allow for a TCP connect to complete for each
# transaction.  If this value is exceeded, then the stack will generate a 408
# or try the next available DNS entry.  A value of 0 means no special timer:
# error out on receiving an RST/ACK error or on SIP transaction timeout (32
# seconds when T1 is 500).
# Default: 10000 (10 seconds)
#TCPConnectTimeout = 0

# The amount of time, in ms, that a DNS record will stay greylisted for after
# receiving a transport failure.  Greylisted DNS records are not considered
# for use until they timeout, or all DNS records returned from a lookup become
# greylisted.
# Default: 1800000 (30 minutes)
#DNSGreylistDuration = 300000

# Disable outbound support (RFC5626).
# WARNING: Before disabling this, ensure you have a RecordRouteUri setup, or
# are using the alternate transport specification mechanism and defining a
# RecordRouteUri per transport: Transport<Num>RecordRouteUri
# WebSocket / WebRTC users: it is usually necessary to set this to false.
# Default: false (outbound support is enabled)
DisableOutbound = true

# Set the draft version of outbound to support.
# Other accepted values are the versions of the IETF drafts, before RFC5626
# was issued (ie. 5, 8, etc.)
# Default: 5626 (RFC5626)
#OutboundVersion = 8

# There are cases where the first hop in a particular network supports the
# concept of outbound and ensures all messaging for a client is delivered over
# the same connection used for registration.  This could be an SBC or other
# NAT traversal aid router that uses the Path header.  However such endpoints
# may not be 100% compliant with the outbound RFC and may not include a ;ob
# parameter in the Path header.  This parameter is required in order for repro
# to have knowledge that the first hop does support outbound, and it will
# reject registrations that appear to be using outbound (ie. instanceId and
# regId) with a 439 (First Hop Lacks Outbound Support).  In this case it can
# be desirable when using repro as the registrar to not reject REGISTER
# requests that contain an instanceId and regId with a 439.
# If this setting is enabled, then repro will assume the first hop supports
# outbound and not return this error.
# Default: false
#AssumeFirstHopSupportsOutbound = true

# AssumeFirstHopSupportsOutbound only relaxes the outbound logic for
# registrations from clients who send the instance-id and reg-id parameters.
# If the registrations pass through an edge proxy or SBC with the
# useRRTokenHack or clientNATDetection hacks enabled before reaching the
# registration server, the registration server can also potentially accept
# registrations that have come through that proxy with Path headers.
# If this setting is enabled, repro will assume the first hop supports
# outbound or flow token hacks and will not reject registrations with the 439
# error.
# Default: false
#AssumeFirstHopSupportsFlowTokens = true

# Enable use of flow-tokens in non-outbound cases.
# WARNING: Before enabling this, ensure you have a RecordRouteUri setup, or
# are using the alternate transport specification mechanism and defining a
# RecordRouteUri per transport: Transport<Num>RecordRouteUri
# WebSocket / WebRTC users: it is usually necessary to set this to true.
# Default: false
#EnableFlowTokens = true

# If EnableFlowTokens is enabled, then by default flow tokens are only used
# for inbound Record-Routes if the client is directly connected (ie: has only
# a single Via header).  If you enable this setting then inbound flow tokens
# will be used for non-directly connected clients as well (ie: any number of
# Via headers).
# This is particularly useful for TLS based connections between two SIP
# proxies, to help ensure a single TLS connection per dialog.  It avoids an
# issue where a UAC request may be using an IP address in its TLS based
# Record-Route but is presenting a certificate that does not contain the IP
# address.
# Default: false
#AllowInboundFlowTokensForNonDirectClients = true

# Enable use of flow-tokens in non-outbound cases for clients detected to be
# behind a NAT.  This is a more selective flow token hack mode for clients not
# supporting RFC5626.  The original flow token hack (EnableFlowTokens) will
# use flow tokens on all client requests.
# Possible values: DISABLED, ENABLED, PRIVATE_TO_PUBLIC
# WARNING: Before enabling this, ensure you have a RecordRouteUri setup, or
# are using the alternate transport specification mechanism and defining a
# RecordRouteUri per transport: Transport<Num>RecordRouteUri
# Default: DISABLED
#ClientNatDetectionMode = ENABLED

# Set to greater than 0 to enable addition of the Flow-Timer header to
# REGISTER responses if outbound is enabled.  Units are seconds.
# Note:  When set, TCPConnectionGCAge defaults to 7200 seconds.
# Default: 0 (disabled)
#FlowTimer = 120

# When set to false, we only allow relaying (forwarding of a request that is
# not From one of our domain users to a destination that is not one of our
# domains) if the sending source is in our ACL list.  With this set to true we
# will always allow requests to be relayed.
# Default: false
#AlwaysAllowRelaying = true

# When set to false, we will strip the Proxy-Authorization headers from
# forwarded requests when forwarding outside of our domain and the
# Proxy-Authorization realm is our domain.  With this set to true we will
# never strip the Proxy-Authorization headers from forwarded requests.
# Default: false
#NeverStripProxyAuthorizationHeaders = true

# Enabling this setting allows the DigestAuthenticator to allow a request to
# be authorized using a digest user that is different from the user specified
# in the From header.  This applies to mid-dialog requests only.  This is
# necessary to properly support call forwarding scenarios.  Consider this
# scenario:
# -User A calls User B
# -User B sends a 302 redirect to redirect A to User C
# -User A resends INVITE to User C.  This INVITE still has User B in the To
#  header.
# -Sometime during the call between A and C, User C decides to put the call on
#  hold.
# This results in a reINVITE from C to A, however User B is in the From
# header.  If this setting is false, then the DigestAuthenticator will return
# a 403 (forged request) because the auth info provided is for User C, yet the
# From header is User B.
# Default: false
AllowInDialogImpersonationWithinRealm = true


########################################################
# CertificateAuthenticator Monkey Settings
########################################################

# Enable the certificate authenticator.
# Note:  You MUST use a TLS transport with TlsClientVerification set to
#        Optional or Mandatory.
# There are two levels of checking:
# a) cert must be signed by a CA trusted by the stack
# b) the CN or one of the subjectAltName values must match the From: header of
#    each SIP message on the TLS connection
# Examples:
# Cert 1:
#    common name = daniel@pocock.pro
#    => From: <daniel@pocock.pro> is the only value that will pass
# Cert 2:
#    subjectAltName = pocock.pro
#    => From: <<anything>@pocock.pro> will be accepted
# Typically, case 1 is for a real client connection (e.g. Jitsi), case 2
# (whole domain) is for federated SIP proxy-to-proxy communication (RFC 5922).
# Default: false
#EnableCertificateAuthenticator = true

# A static text file that contains mappings of X.509 Common Names to permitted
# SIP `From:' addresses.
#
# Without this file, the default behavior of the CertificateAuthenticator
# ensures that the `From:' address in SIP messages must match the Common Name
# or one of the subjectAltNames from the X.509 certificate.
#
# When this file is supplied, the CertificateAuthenticator will continue to
# allow SIP messages where there is an exact match between the certificate and
# the `From:' address, but it will also allow the holder of a particular
# certificate to use any of the `mapped' `From:' addresses specified in the
# mappings file.
#
# File format:
# common name<TAB><mapping>,<mapping>,...
#
#    where:
#        <TAB> is exactly one tab
#        <mapping> is `user@domain' or just `domain'
#
# Default: (empty - repro will not look for a mappings file)
#CommonNameMappings = /etc/repro/tlsUserMappings.txt


########################################################
# DigestAuthenticator Monkey Settings
########################################################

# Disable DIGEST challenges - disables this monkey
# Default: false
#DisableAuth = true

# Always use a specified realm name to challenge.
# Default: (empty - challenge using the hostname from the request URI as the
#          realm)
#StaticRealm = sipdomain.com

# Enable RADIUS lookups (only works if DIGEST is enabled)
# Default: false
#EnableRADIUS = true

# Specify the configuration file the RADIUS client should use.
# This is the file that specifies the name of the RADIUS server to use and
# other essential parameters.
# If different processes each have different RADIUS parameters, they can copy
# the radiusclient.conf file to a non-standard location and modify it as
# required.
#
# Note the following:
# - the seqfile specified in the RADIUS configuration file must be writeable
#   by the user the repro process runs as.  It is a good idea to locate that
#   file in a directory such as /var/run/repro owned by repro.
# - the dictionary must include various elements such as Sip-Session, copy
#   these from the sample dictionary.sip file.
#
# Default: /etc/radiusclient/radiusclient.conf
#RADIUSConfiguration = /etc/repro/radiusclient.conf

# HTTP hostname for this server (used in Identity headers)
# Default: (empty)
#HttpHostname = sip-server.example.org

# Disable adding identity headers
# Default: false
#DisableIdentity = true

# Enable addition and processing of P-Asserted-Identity headers
# Default: false
#EnablePAssertedIdentityProcessing = true

# Disable auth-int DIGEST challenges
# Default: false
DisableAuthInt = true

# Send 403 if a client sends a bad nonce in their credentials (a new challenge
# is sent otherwise).
# Default: false
#RejectBadNonces = true

# Allow a To tag in registrations
# Default: false
#AllowBadReg = true

# An ordered list of algorithms to use for generating DIGEST challenges.
# repro must be compiled with OpenSSL support for the SHA algorithms.
# Default: (empty - MD5 only challenges)
#DigestChallengeAlgorithms = MD5, SHA-256, SHA-512-256


########################################################
# Cookie Authentication Settings
########################################################

# Shared secret for cookie HMAC validation.
#
# See
#  http://www.resiprocate.org/SIP_Over_WebSocket_Cookies
# for details of the cookie authentication scheme.
#
# Default: (empty - there is no cookie validation)
#WSCookieAuthSharedSecret = my-shared-secret

# Names of the cookies to use for the cookie authentication protocol.
# Only applicable when WSCookieAuthSharedSecret is specified.
# Defaults: WSSessionInfo, WSSessionExtra and WSSessionMAC respectively
#WSCookieNameInfo = MySessionInfo
#WSCookieNameExtra = MySessionExtra
#WSCookieNameMAC = MySessionMAC

# Name of the extension header that must match the content of the
# authenticated WSSessionExtra cookie.
# Default: X-WS-Session-Extra
#WSCookieExtraHeaderName = X-My-Session-Extra


########################################################
# RequestFilter Monkey Settings
########################################################

# Disable RequestFilter monkey processing
# Default: false
#DisableRequestFilterProcessor = true

# Default behavior for when no matching filter is found.  Leave empty to allow
# request processing to continue.  Otherwise set to a SIP status error code
# (400-699) that should be used to reject the request (ie. 500).
# The status code can optionally be followed by a , and SIP reason text.
# Default: (empty - request processing continues)
#RequestFilterDefaultNoMatchBehavior = 500, Server Internal Error

# Default behavior for SQL query DB errors.  Leave empty to allow request
# processing to continue.  Otherwise set to a SIP status error code (400-699)
# that should be used to reject the request (ie. 500).
# The status code can optionally be followed by a , and SIP reason text.
# Note: DB support for this action requires SQL support.
# Default: 500, Server Internal DB Error
#RequestFilterDefaultDBErrorBehavior = 503, Service Unavailable

# The database index to connect to for any blocked entries that are configured
# to use a SQL statement.
#
# WARNING: repro must be compiled with the USE_MYSQL or USE_POSTGRESQL flags
# in order for this to work.
#
# See the Database settings section for details on how to declare a database
# connection.
#
# Example, specify that Database3* settings should be used for the
# RequestFilter:
#
# Default: -1 - fall back to the RuntimeDatabase, then the DefaultDatabase
#RequestFilterDatabase = 3


########################################################
# StaticRoute Monkey Settings
########################################################

# Specify where to route requests that are in this proxy's domain - disables
# the routes in the web interface and uses a SimpleStaticRoute monkey instead.
# A comma separated list of routes can be specified here and each route will
# be added to the outbound requests with the RequestUri left intact.
# Default: (empty - use the routes from the web interface)
#Routes = sip:proxy.example.org;lr

# Parallel fork to all matching static routes
# Default: false
#ParallelForkStaticRoutes = true

# By default (false) we will stop looking for more targets if we have found
# matching routes.  Setting this value to true will allow the LocationServer
# monkey to run after StaticRoutes have been found.  In this case the matching
# StaticRoutes become fallback targets, processed only after all location
# server targets fail.
# Default: false
#ContinueProcessingAfterRoutesFound = true

# Challenge calls from third-party domains to local domains.
# If certificate authentication is enabled and a request arrives over TLS,
# they will still not be challenged anyway if their domain certificate
# validates their message.
# Note:  This setting has no effect when DisableAuth is set to true.
# Default: true
#ChallengeThirdPartiesCallingLocalDomains = false


########################################################
# Message Silo Monkey Settings
########################################################

# Specify whether the Message Silo is enabled or not.  If enabled, then repro
# will store MESSAGE requests for users that are not online.  When the user is
# back online (ie. registers with repro), the stored messages will be
# delivered.
# Default: false
#MessageSiloEnabled = true

# A regular expression that can be used to filter which URIs not to do message
# storage (siloing) for.  Destination/To URIs matching this regular expression
# will not be silo'd.
# Default: (empty - no destinations are filtered)
#MessageSiloDestFilterRegex = ^sip:noreply@.*$

# A regular expression that can be used to filter which body/content/mime
# types not to do message storage (siloing) for.  Content-Types matching this
# regular expression will not be silo'd.
# Default: application\/im\-iscomposing\+xml
#MessageSiloMimeTypeFilterRegex = application\/.*\+xml

# The number of seconds a message request will be stored in the message silo.
# Messages older than this time are candidates for deletion.
# Default: 2592000 (30 days)
#MessageSiloExpirationTime = 604800

# Flag to indicate if a Date header should be added to replayed SIP MESSAGEs
# from the silo, when a user registers.
# Default: true
#MessageSiloAddDateHeader = false

# Defines the maximum message content length (bytes) that will be stored in
# the message silo.  Messages with a Content-Length larger than this value
# will be discarded.
# WARNING:  Do not increase this value beyond the capabilities of the database
# storage or internal buffers.
# Note: AbstractDb uses a read buffer size of 8192 - do not exceed this size.
# Default: 4096
#MessageSiloMaxContentLength = 2048

# The status code returned to the sender when a message is successfully
# silo'd.
# Default: 202
#MessageSiloSuccessStatusCode = 200

# The status code returned to the sender when a message's mime-type matches
# the MessageSiloMimeTypeFilterRegex.  Can be used to avoid sending errors to
# isComposing mime bodies that don't need to be silo'd.  Set to 0 to use the
# repro standard response (ie. 480).
# Default: 200
#MessageSiloFilteredMimeTypeStatusCode = 0

# The status code returned to the sender when a message is not silo'd due to
# the MessageSiloMaxContentLength being exceeded.
# Default: 480
#MessageSiloFailureStatusCode = 413


########################################################
# Recursive Redirect Lemur Settings
########################################################

# Handle 3xx responses in the proxy - enables the Recursive Redirect Lemur
# Default: false
#RecursiveRedirect = true


########################################################
# Geo Proximity Target Sorter Baboon Settings
########################################################

# If enabled, then this baboon can post-process the target list.  This
# includes targets from the StaticRoute monkey and/or targets from the
# LocationServer monkey.  Requests that meet the filter criteria will have
# their target list flattened (serialized) and ordered based on the proximity
# of the target to the client sending the request.  Proximity is determined by
# looking for an x-repro-geolocation="<latitude>,<longitude>" parameter on the
# Contact header of a received request, or the Contact headers of registration
# requests.  If this parameter is not found, then this processor will attempt
# to determine the public IP address closest to the client or target and use
# the MaxMind Geo IP library to look up the geo location.
# Default: false
#GeoProximityTargetSorting = true

# Specify the full path to the IPv4 Geo City database file.
# Note:  A free version of the database can be downloaded from here:
# http://geolite.maxmind.com/download/geoip/database/GeoLiteCity.dat.gz
# For a more accurate database, please see the details here:
# http://www.maxmind.com/app/city
# Leave blank to disable V4 lookups.
# Default: GeoLiteCity.dat
#GeoProximityIPv4CityDatabaseFile = /usr/share/GeoIP/GeoLiteCity.dat

# Specify the full path to the IPv6 Geo City database file.
# Note:  A free version of the database can be downloaded from here:
# http://geolite.maxmind.com/download/geoip/database/GeoLiteCityv6-beta/
# For a more accurate database, please see the details here:
# http://www.maxmind.com/app/city
# Leave blank to disable V6 lookups.  Saves memory (if not required).
# Default: GeoLiteCityv6.dat
GeoProximityIPv6CityDatabaseFile =

# This setting specifies a PCRE compliant regular expression to attempt to
# match against the request URI of inbound requests.  Any requests matching
# this expression will have their targets sorted as described above.  Leave
# blank to match all requests.
# Default: (empty - match all requests)
#GeoProximityRequestUriFilter = ^sip:mediaserver.*@mydomain.com$

# The distance (in kilometers) to use for proximity sorting, when the geo
# location of a target cannot be determined.
# Default: 0
#GeoProximityDefaultDistance = 1000

# If enabled, then targets that are determined to be of equal distance from
# the client will be placed in a random order.
# Default: true
#LoadBalanceEqualDistantTargets = false


########################################################
# Q-Value Target Handler Baboon Settings
########################################################

# Enable sequential q-value processing - enables the baboon
# Default: true
#QValue = false

# Specify forking behavior for q-value targets.
# Possible values: FULL_SEQUENTIAL, EQUAL_Q_PARALLEL, FULL_PARALLEL
# Default: EQUAL_Q_PARALLEL
#QValueBehavior = FULL_SEQUENTIAL

# Whether to cancel groups of parallel forks after the period specified by the
# QValueMsBeforeCancel setting.
# Default: true
#QValueCancelBetweenForkGroups = false

# Milliseconds to wait before cancelling parallel fork groups when
# QValueCancelBetweenForkGroups is true.
# Default: 30000
#QValueMsBeforeCancel = 15000

# Whether to wait for parallel fork groups to terminate before starting new
# fork groups.
# Default: true
#QValueWaitForTerminateBetweenForkGroups = false

# Milliseconds to wait before starting new groups of parallel forks when
# QValueWaitForTerminateBetweenForkGroups is false.
# Default: 3000
#QValueMsBetweenForkGroups = 5000


########################################################
# Include other configuration files
########################################################

# It is possible to include one or more additional configuration files using
# the Include directive one or more times.
#Include = /etc/repro/more-transports.config
